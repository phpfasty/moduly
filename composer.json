{
    "name": "phpfasty/moduly",
    "description": "ModulY: CMS-agnostic PHP module loader core.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [{ "name": "PHP FastY", "homepage": "https://github.com/phpfasty" }],
    "require": { "php": ">=8.2" },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": { "psr-4": { "PhpFasty\\Moduly\\": "src/" } },
    "autoload-dev": { "psr-4": { "PhpFasty\\Moduly\\Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs"
    },
    "config": { "sort-packages": true }
}
