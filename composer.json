{
    "name": "phpfasty/moduly",
    "description": "ModulY: CMS-agnostic PHP module loader core.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "PHP FastY",
            "homepage": "https://github.com/phpfasty"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-zip": "*"
    },
    "require-dev": {
        "paragonie/sodium_compat": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "PhpFasty\\Moduly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpFasty\\Moduly\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs"
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "ext-sodium": "Fast ed25519 verification (WordPress ships paragonie/sodium_compat as a fallback)"
    },
    "bin": [
        "bin/moduly"
    ]
}
